<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ops Dashboard Access</title>
  <link rel="icon" href="/public/od-icon.svg" />
  <link rel="manifest" href="/public/manifest.webmanifest" />
  <meta name="theme-color" content="#0f1115" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="stylesheet" href="/public/style.css" />
</head>
<body class="access-page">
  <main class="access-shell">
    <article class="card access-card">
      <div class="access-brand">
        <div class="access-brand__mark" aria-hidden="true">
          <span class="access-brand__dot"></span>
        </div>
        <h1>OpenClaw</h1>
        <p>Gateway Dashboard</p>
      </div>

      <div class="access-section">
        <div class="auth-tabs" role="tablist" aria-label="Sign in methods">
          <button id="nip07_tab" class="btn btn-tab" type="button" role="tab" aria-selected="true" aria-controls="nip07_panel">NIP-07</button>
          <button id="amber_tab" class="btn btn-tab" type="button" role="tab" aria-selected="false" aria-controls="amber_panel">Amber / Nostr Connect</button>
          <button id="nsec_tab" class="btn btn-tab" type="button" role="tab" aria-selected="false" aria-controls="nsec_panel">nsec</button>
        </div>
        <div class="field__hint">Use the signer that matches the device you have in front of you.</div>

        <section id="nip07_panel" class="auth-panel" role="tabpanel" aria-labelledby="nip07_tab">
          <div class="field">
            <div class="field__hint">Use the browser signer already available on this device.</div>
          </div>
          <div class="actions">
            <button id="nip07_login_btn" class="btn btn-primary btn-block" type="button">Log in with NIP-07</button>
          </div>
        </section>

        <section id="amber_panel" class="auth-panel" role="tabpanel" aria-labelledby="amber_tab" hidden>
          <div class="field">
            <label for="amber_relays">Relay(s)</label>
            <input id="amber_relays" type="text" value="<%= defaultRelayUrls %>" placeholder="wss://relay.damus.io, wss://relay.primal.net, wss://relay.nostr.band" />
          </div>
          <div class="actions">
            <button id="amber_login_btn" class="btn btn-primary btn-block" type="button">Log in with Amber</button>
          </div>
        </section>

        <section id="nsec_panel" class="auth-panel" role="tabpanel" aria-labelledby="nsec_tab" hidden>
          <div class="field">
            <label for="nsec_value">nsec</label>
            <textarea id="nsec_value" rows="2" spellcheck="false" placeholder="Paste an nsec here for local signing"></textarea>
          </div>
          <div class="actions">
            <button id="nsec_login_btn" class="btn btn-primary btn-block" type="button">Log in with nsec</button>
          </div>
        </section>

        <div id="session_stage" class="access-stage" hidden>
          <div class="actions access-actions">
            <button id="fetch_btn" class="btn btn-primary btn-block" disabled>Fetch dashboard /</button>
            <button id="connect_btn" class="btn" disabled hidden>Connect WebRTC</button>
          </div>
        </div>

        <div id="preview" class="access-status">Waiting for sign in…</div>

        <div id="session_meta" class="mono-block" hidden>
          <div><span>Session</span><code id="session_id">(none)</code></div>
          <div><span>Signal URL</span><code id="signal_url">(none)</code></div>
          <div><span>Proxy URL</span><code id="proxy_url">(none)</code></div>
        </div>

        <details class="access-advanced">
          <summary>Advanced</summary>

          <div class="actions">
            <button id="bootstrap_btn" class="btn btn-primary btn-block" type="button">Connect</button>
          </div>

          <div class="field">
            <label for="amber_uri">Amber connection URI</label>
            <textarea id="amber_uri" rows="3" spellcheck="false" readonly placeholder="A nostrconnect:// URI will appear here"></textarea>
            <div class="field__hint">Amber should open automatically after you tap the button. If it does not, copy the URI into Amber manually.</div>
          </div>

          <div class="field">
            <label for="event_json">Wrapped event JSON</label>
            <textarea id="event_json" rows="10" spellcheck="false" placeholder="Generated wrapped event will appear here"></textarea>
          </div>
        </details>

        <section class="access-help">
          <h2>How to connect</h2>
          <ol>
            <li>Choose a signing method and approve the request.</li>
            <li>Wait for the access session to be issued.</li>
            <li>Use <strong>Fetch dashboard /</strong> to land on the dashboard.</li>
          </ol>
        </section>
      </div>
    </article>
  </main>

  <script>
    window.ACCESS_GATEWAY = {
      app: '<%= accessApp %>',
      gatewayPubkey: '<%= gatewayIdentity.pubkey %>',
      gatewayNpub: '<%= gatewayIdentity.npub %>',
      relayUrls: '<%= defaultRelayUrls %>',
    };
    window.FIPS_STUN_URL = '<%= stunUrl %>';
  </script>
  <script src="/public/vendor/nostr.bundle.js" defer></script>
  <script src="/public/webrtc-proxy.js" defer></script>
  <script src="/public/access-page.js" defer></script>
  <script src="/public/pwa-register.js" defer></script>
</body>
</html>
