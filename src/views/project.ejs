<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= project.name %> | vibez</title>
  <link rel="icon" href="/public/od-icon.svg" />
  <link rel="manifest" href="/public/manifest.webmanifest" />
  <meta name="theme-color" content="#0f1115" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="stylesheet" href="/public/style.css" />
</head>
<body data-page="project" data-project-id="<%= project.id %>" data-active-tab="<%= activeTab %>">
  <% const tabLabels = { overview: 'Overview', conversations: 'Chat', 'main-agent': 'OpenClaw Main', workflows: 'Workflows', memory: 'Memory', files: 'Files', logs: 'Logs', settings: 'Settings' }; %>
  <% const tabHref = function(tab) { return '/project/' + project.id + '?tab=' + tab + (activeSession ? '&session=' + encodeURIComponent(activeSession) : ''); }; %>
  <% const mainAgentHref = '/project/' + project.id + '?tab=main-agent'; %>
  <% const agentById = Object.fromEntries(agents.map(function(agent) { return [agent.id, agent]; })); %>
  <% const conversationAgentId = conversationAgent ? conversationAgent.id : ''; %>
  <% const conversationAgentLabel = conversationAgent ? conversationAgent.name : 'OpenClaw Main'; %>
  <% const hasMainAgentInfo = typeof mainAgent !== 'undefined' && mainAgent && typeof mainStats !== 'undefined' && mainStats; %>
  <% const hasMainProjectInfo = typeof mainProject !== 'undefined' && mainProject; %>
  <% const hasMainStateInfo = typeof mainState !== 'undefined' && mainState; %>
  <% const projectView = activeTab === 'conversations' || activeTab === 'main-agent' ? 'session' : (activeTab === 'settings' ? 'config' : (activeTab === 'logs' ? 'logs' : 'overview')); %>
  <% const projectSettings = project.settings_json || {}; %>
  <% const projectCodeFolder = projectSettings.code_folder || project.workspace_dir || ''; %>
  <% const projectSubtitle = project.description && !/^Imported from/i.test(project.description) ? project.description : ''; %>
  <% const projectGettingStarted = projectSettings.getting_started || projectSettings.instructions || ''; %>
  <% const projectBackend = typeof projectBackendSettings !== 'undefined' && projectBackendSettings ? projectBackendSettings : {}; %>
  <% const projectUsageData = typeof projectUsage !== 'undefined' && projectUsage ? projectUsage : null; %>
  <% const latestCommitSnapshot = projectMemory && projectMemory.latestCommit ? projectMemory.latestCommit : null; %>
  <% const projectWorkspaceBranch = typeof workspaceBranch !== 'undefined' && workspaceBranch ? workspaceBranch : (projectMemory && projectMemory.workspaceBranch ? projectMemory.workspaceBranch : (latestCommitSnapshot && latestCommitSnapshot.branch ? latestCommitSnapshot.branch : '')); %>
  <% const recentFileSortState = typeof recentFileSort !== 'undefined' && recentFileSort ? String(recentFileSort) : 'recent:desc'; %>
  <% const recentFileSortParts = recentFileSortState.split(':'); %>
  <% const recentFileSortKey = recentFileSortParts[0] || 'recent'; %>
  <% const recentFileSortDirection = recentFileSortParts[1] || (recentFileSortKey === 'recent' ? 'desc' : 'asc'); %>
  <% const recentFileSortArrow = function(sortKey, direction) {
       if (sortKey === 'name' || sortKey === 'path') return direction === 'asc' ? '↓' : '↑';
       return direction === 'asc' ? '↑' : '↓';
     }; %>
  <% const messageAuthor = function(message) {
       if (message.direction === 'outbound') return 'You';
       const agent = message.agent_id && agentById[message.agent_id] ? agentById[message.agent_id].name : '';
       if (agent) return agent;
       return message.message_type === 'codex' ? 'Codex' : 'Agent';
     }; %>
  <% const projectSearchText = function(p) { return [p.name, p.id, p.description, p.status, p.sectionLabel, p.section, p.activityLabel, p.favorite ? 'favourite pinned' : '', p.archived ? 'archived' : '', (p.tags || []).join(' '), p.session_count, p.workflow_count, p.created_at, p.last_activity].filter(Boolean).join(' ').toLowerCase(); }; %>
  <% const fileNameFromPath = function(filePath) {
       const value = String(filePath || '').trim();
       if (!value) return '(unknown file)';
       const parts = value.split('/').filter(Boolean);
       return parts.length ? parts[parts.length - 1] : value;
     }; %>
  <% const recentFileViewerHref = function(filePath) {
       return '/project/' + encodeURIComponent(project.id) + '/file?path=' + encodeURIComponent(String(filePath || ''));
     }; %>
  <% const truncateChatMessage = function(value) {
       var text = String(value || '(empty)');
       if (text.length <= 2500) {
         return {
           preview: text,
           full: text,
           truncated: false,
         };
       }
       var visibleText = text.slice(0, 2500).replace(/\s+$/, '');
       return {
         preview: visibleText + '...',
         full: text,
         truncated: true,
       };
     }; %>
  <% const escapeHtml = function(value) {
       return String(value)
         .replace(/&/g, '&amp;')
         .replace(/</g, '&lt;')
         .replace(/>/g, '&gt;')
         .replace(/"/g, '&quot;')
         .replace(/'/g, '&#39;');
     }; %>
  <% const renderDiffMarkup = function(value) {
       const lines = String(value || 'No diff available.').replace(/\r\n?/g, '\n').split('\n');
       const classify = function(line) {
         if (!line) return 'blank';
         if (line.startsWith('diff --git') || line.startsWith('index ') || line.startsWith('Binary files')) return 'header';
         if (line.startsWith('--- ')) return 'del-file';
         if (line.startsWith('+++ ')) return 'add-file';
         if (line.startsWith('@@')) return 'hunk';
         if (line.startsWith('+') && !line.startsWith('+++')) return 'add';
         if (line.startsWith('-') && !line.startsWith('---')) return 'del';
         if (line.startsWith('\\ ')) return 'meta';
         return 'context';
       };

       return lines.map(function(line) {
         const kind = classify(line);
         const text = line ? escapeHtml(line) : '&nbsp;';
         return '<span class="recent-file-diff-line recent-file-diff-line--' + kind + '">' + text + '</span>';
       }).join('');
     }; %>
  <% const recentFiles = (() => {
       const fileChanges = (typeof recentFileChanges !== 'undefined' && Array.isArray(recentFileChanges)) ? recentFileChanges : [];
       if (fileChanges.length) return fileChanges;
       const artifactFiles = ((projectMemory && Array.isArray(projectMemory.recentArtifacts)) ? projectMemory.recentArtifacts : [])
         .map(function(item) {
           return {
             status: 'ART',
             status_label: 'Artifact',
             file_path: item.file_path || item.name || '',
             updated_at: item.created_at || '',
             change_summary: 'recent artifact',
           };
         })
         .filter(function(item) { return item.file_path; });
       return artifactFiles;
     })(); %>
  <% const sidebarGroups = typeof projectGroups !== 'undefined' && projectGroups ? projectGroups : { recent: [], favourites: [], favorites: [], general: [], pave: [], sec06: [], archived: [] }; %>
  <% const favouriteProjects = sidebarGroups.favourites || sidebarGroups.favorites || []; %>
  <% const archivedProjects = sidebarGroups.archived || []; %>

  <div class="shell">
    <aside class="sidebar" id="project_sidebar" data-project-filter-root>
      <div class="brand">
        <div class="brand__mark"><img src="/public/od-icon.svg" alt="" /></div>
        <div>
          <h1><a href="/">vibez</a></h1>
        </div>
      </div>

      <button type="button" class="sidebar-collapse-tab" data-sidebar-desktop-toggle aria-controls="project_sidebar" aria-expanded="true" aria-label="Collapse projects sidebar" title="Collapse projects sidebar">
        <span class="sidebar-collapse-tab__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <div class="search-box">
        <input id="project_search" type="search" placeholder="Search projects...." autocomplete="off" spellcheck="false" data-project-filter-input />
      </div>

      <div class="sidebar-scroll" data-sidebar-scroll>
      <% if (favouriteProjects.length) { %>
        <section class="sidebar-section sidebar-section--collapsible" data-sidebar-collapsible data-sidebar-section-key="favourites" data-project-section>
          <button type="button" class="sidebar-section__titlebar" data-sidebar-collapse aria-expanded="true">
            <span class="sidebar-section__title">Pinned</span>
            <span class="sidebar-section__count">(<%= favouriteProjects.length %>)</span>
            <span class="sidebar-section__chevron" aria-hidden="true">▾</span>
          </button>
          <div class="project-list" data-project-group data-sidebar-body>
            <% favouriteProjects.forEach(function(p) { %>
              <div class="project-item project-item--favorite <%= p.id === project.id ? 'project-item--active' : '' %>" data-project-item data-project-search="<%= projectSearchText(p) %>">
                <div class="project-item__content">
                  <a class="project-item__link" href="/project/<%= p.id %>">
                    <span class="project-item__top">
                      <strong><%= p.name %></strong>
                      <span class="badge badge-accent"><%= p.sectionLabel %></span>
                    </span>
                    <span class="project-item__sub"><%= p.status %> | <%= p.session_count %> sessions | <%= p.workflow_count %> workflows</span>
                    <span class="project-item__foot"><%= p.activityLabel %></span>
                  </a>
                </div>
                <form method="post" action="/api/projects/<%= p.id %>/favorite" class="project-item__pin-form">
                  <input type="hidden" name="favorite" value="0" />
                  <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                  <button type="submit" class="project-item__pin-btn" aria-label="Remove from favourites" title="Remove from favourites">
                    <svg class="project-item__pin-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M9 3h6l.8 5.2c.1.6.4 1.2.9 1.6l1.8 1.5c.3.2.5.6.5 1v1.2H14l-1 8-1-8H4.8v-1.2c0-.4.2-.7.5-1l1.8-1.5c.5-.4.8-1 .9-1.6L9 3zm1.8 1.8-.5 3.4c-.2 1-.6 1.9-1.3 2.7l-.7.7h7.4l-.7-.7c-.7-.7-1.1-1.7-1.3-2.7l-.5-3.4h-2.4z"></path>
                    </svg>
                  </button>
                </form>
                <form method="post" action="/api/projects/<%= p.id %>/archive" class="project-item__archive-form">
                  <input type="hidden" name="archived" value="1" />
                  <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                  <button type="submit" class="project-item__archive-btn" aria-label="Archive project" title="Archive">Archive</button>
                </form>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (sidebarGroups.recent.length) { %>
        <section class="sidebar-section sidebar-section--collapsible" data-sidebar-collapsible data-sidebar-section-key="recent" data-project-section>
          <button type="button" class="sidebar-section__titlebar" data-sidebar-collapse aria-expanded="true">
            <span class="sidebar-section__title">Recent</span>
            <span class="sidebar-section__count">(<%= sidebarGroups.recent.length %>)</span>
            <span class="sidebar-section__chevron" aria-hidden="true">▾</span>
          </button>
          <div class="project-list" data-project-group data-sidebar-body>
            <% sidebarGroups.recent.forEach(function(p) { %>
              <div class="project-item <%= p.id === project.id ? 'project-item--active' : '' %>" data-project-item data-project-search="<%= projectSearchText(p) %>">
                <div class="project-item__content">
                  <a class="project-item__link" href="/project/<%= p.id %>">
                    <span class="project-item__top">
                      <strong><%= p.name %></strong>
                      <span class="badge badge-neutral"><%= p.sectionLabel %></span>
                    </span>
                    <span class="project-item__sub"><%= p.status %> | <%= p.session_count %> sessions | <%= p.workflow_count %> workflows</span>
                    <span class="project-item__foot"><%= p.activityLabel %></span>
                  </a>
                </div>
                <form method="post" action="/api/projects/<%= p.id %>/favorite" class="project-item__pin-form">
                  <input type="hidden" name="favorite" value="1" />
                  <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                  <button type="submit" class="project-item__pin-btn" aria-label="Add to favourites" title="Add to favourites">
                    <svg class="project-item__pin-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M9 3h6l.8 5.2c.1.6.4 1.2.9 1.6l1.8 1.5c.3.2.5.6.5 1v1.2H14l-1 8-1-8H4.8v-1.2c0-.4.2-.7.5-1l1.8-1.5c.5-.4.8-1 .9-1.6L9 3zm1.8 1.8-.5 3.4c-.2 1-.6 1.9-1.3 2.7l-.7.7h7.4l-.7-.7c-.7-.7-1.1-1.7-1.3-2.7l-.5-3.4h-2.4z"></path>
                    </svg>
                  </button>
                </form>
                <form method="post" action="/api/projects/<%= p.id %>/archive" class="project-item__archive-form">
                  <input type="hidden" name="archived" value="1" />
                  <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                  <button type="submit" class="project-item__archive-btn" aria-label="Archive project" title="Archive">Archive</button>
                </form>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <section class="sidebar-section sidebar-section--collapsible" data-sidebar-collapsible data-sidebar-section-key="projects" data-project-section>
        <button type="button" class="sidebar-section__titlebar" data-sidebar-collapse aria-expanded="true">
          <span class="sidebar-section__title">Projects</span>
          <span class="sidebar-section__count">(<%= (sidebarGroups.general || []).length %>)</span>
          <span class="sidebar-section__chevron" aria-hidden="true">▾</span>
        </button>
        <div class="project-list" data-project-group data-sidebar-body>
          <% sidebarGroups.general.forEach(function(p) { %>
            <div class="project-item <%= p.id === project.id ? 'project-item--active' : '' %>" data-project-item data-project-search="<%= projectSearchText(p) %>">
              <div class="project-item__content">
                <a class="project-item__link" href="/project/<%= p.id %>">
                  <span class="project-item__top">
                    <strong><%= p.name %></strong>
                    <span class="badge <%= p.id === project.id ? 'badge-accent' : 'badge-neutral' %>"><%= p.sectionLabel %></span>
                  </span>
                  <span class="project-item__sub"><%= p.status %> | <%= p.session_count %> sessions | <%= p.workflow_count %> workflows</span>
                  <span class="project-item__foot"><%= p.activityLabel %></span>
                </a>
              </div>
              <form method="post" action="/api/projects/<%= p.id %>/favorite" class="project-item__pin-form">
                <input type="hidden" name="favorite" value="1" />
                <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                <button type="submit" class="project-item__pin-btn" aria-label="Add to favourites" title="Add to favourites">
                  <svg class="project-item__pin-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9 3h6l.8 5.2c.1.6.4 1.2.9 1.6l1.8 1.5c.3.2.5.6.5 1v1.2H14l-1 8-1-8H4.8v-1.2c0-.4.2-.7.5-1l1.8-1.5c.5-.4.8-1 .9-1.6L9 3zm1.8 1.8-.5 3.4c-.2 1-.6 1.9-1.3 2.7l-.7.7h7.4l-.7-.7c-.7-.7-1.1-1.7-1.3-2.7l-.5-3.4h-2.4z"></path>
                  </svg>
                </button>
              </form>
              <form method="post" action="/api/projects/<%= p.id %>/archive" class="project-item__archive-form">
                <input type="hidden" name="archived" value="1" />
                <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                <button type="submit" class="project-item__archive-btn" aria-label="Archive project" title="Archive">Archive</button>
              </form>
            </div>
          <% }) %>
        </div>
      </section>

      <% if (archivedProjects.length) { %>
        <section class="sidebar-section sidebar-section--collapsible" data-sidebar-collapsible data-sidebar-section-key="archived" data-project-section>
          <button type="button" class="sidebar-section__titlebar" data-sidebar-collapse aria-expanded="true">
            <span class="sidebar-section__title">Archived</span>
            <span class="sidebar-section__count">(<%= archivedProjects.length %>)</span>
            <span class="sidebar-section__chevron" aria-hidden="true">▾</span>
          </button>
          <div class="project-list" data-project-group data-sidebar-body>
            <% archivedProjects.forEach(function(p) { %>
              <div class="project-item" data-project-item data-project-search="<%= projectSearchText(p) %>">
                <div class="project-item__content">
                  <a class="project-item__link" href="/project/<%= p.id %>">
                    <span class="project-item__top">
                      <strong><%= p.name %></strong>
                      <span class="badge badge-neutral">Archived</span>
                    </span>
                    <span class="project-item__sub"><%= p.status %> | <%= p.session_count %> sessions | <%= p.workflow_count %> workflows</span>
                    <span class="project-item__foot"><%= p.activityLabel %></span>
                  </a>
                </div>
                <form method="post" action="/api/projects/<%= p.id %>/archive" class="project-item__archive-form">
                  <input type="hidden" name="archived" value="0" />
                  <input type="hidden" name="return_to" value="<%= tabHref(activeTab) %>" />
                  <button type="submit" class="project-item__archive-btn" aria-label="Unarchive project" title="Unarchive">Unarchive</button>
                </form>
              </div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <div class="project-empty" data-project-empty hidden>No projects match your search.</div>
      </div>
    </aside>

    <div class="sidebar-backdrop" data-sidebar-backdrop></div>

    <main class="workspace" data-project-workspace>
      <header class="topbar">
        <div>
          <h1><%= project.name %></h1>
        </div>
        <div class="topbar__meta">
          <button type="button" class="btn sidebar-toggle" data-sidebar-toggle aria-controls="project_sidebar" aria-expanded="false">Projects</button>
          <a class="btn" href="/settings">Settings</a>
          <a class="btn <%= activeTab === 'main-agent' ? 'btn-primary' : '' %>" data-openclaw-main-switch href="<%= mainAgentHref %>">OpenClaw Main</a>
          <form method="post" action="/logout" class="topbar__logout-form">
            <button type="submit" class="btn btn-danger">Logout</button>
          </form>
        </div>
      </header>

      <nav class="tabs" aria-label="Project sections">
        <% projectTabs.filter(tab => tab !== 'main-agent').forEach(function(tab) { %>
          <a class="tab <%= activeTab === tab ? 'tab--active' : '' %> <%= tab === 'conversations' ? 'tab--chat' : 'tab--utility' %>" href="<%= tabHref(tab) %>"><%= tabLabels[tab] || tab %></a>
        <% }) %>
      </nav>

      <div class="project-layout">
        <div class="project-layout__main">
      <% if (activeTab === 'overview') { %>
        <section class="card card--project-info">
          <div class="card__header">
            <div>
              <div class="eyebrow">Project</div>
              <h2>Workspace details</h2>
            </div>
          </div>

          <div class="mono-block mono-block--project">
            <div>
              <span>Project folder</span>
              <code><%= projectCodeFolder || 'local project' %></code>
            </div>
            <div>
              <span>Current branch</span>
              <code><%= projectWorkspaceBranch || 'Unknown' %></code>
            </div>
            <div>
              <span>Agent backend</span>
              <code><%= projectBackend.effectiveBackend || 'openclaw-proxy' %><%= projectBackend.source ? ' · ' + projectBackend.source : '' %></code>
            </div>
            <div>
              <span>Last commit</span>
              <code><%= latestCommitSnapshot ? (latestCommitSnapshot.shortHash + ' · ' + latestCommitSnapshot.message) : 'No commit-linked activity yet' %></code>
            </div>
            <div>
              <span>Commit date</span>
              <code><%= latestCommitSnapshot ? formatDateTime(latestCommitSnapshot.date) : 'Unknown' %></code>
            </div>
            <div>
              <span>Commit author</span>
              <code><%= latestCommitSnapshot ? latestCommitSnapshot.author : 'Unknown' %></code>
            </div>
          </div>

          <% if (latestCommitSnapshot && latestCommitSnapshot.files && latestCommitSnapshot.files.length) { %>
            <div class="recent-files-shell recent-files-shell--project" data-recent-files-root>
              <div class="card__header card__header--compact">
                <div>
                  <div class="eyebrow">Last commit</div>
                  <h2>Changed files</h2>
                </div>
                <span class="badge badge-neutral"><%= latestCommitSnapshot.files.length %> files</span>
              </div>
              <div class="artifact-list artifact-list--compact recent-files-list recent-files-list--tiles">
              <% latestCommitSnapshot.files.forEach(function(item, index) { %>
                <div
                  class="recent-file-item"
                  data-recent-file-item
                  data-file-index="<%= index %>"
                  data-status-label="<%= item.status_label || item.status || 'File' %>"
                  data-file-path="<%= item.file_path %>"
                  data-file-name="<%= fileNameFromPath(item.file_path) %>"
                  data-file-updated-at="<%= item.updated_at || '' %>"
                  data-file-updated-label="<%= formatDateTime(item.updated_at) %>"
                  data-file-updated-relative="<%= formatRelativeTime(item.updated_at) %>"
                  data-file-summary="<%= item.change_summary || '' %>"
                  aria-expanded="false"
                >
                  <button
                    type="button"
                    class="artifact-item artifact-item--button recent-file-item__trigger"
                    data-recent-file-trigger
                    aria-expanded="false"
                    aria-controls="recent-file-detail-commit-<%= index %>"
                  >
                    <span class="recent-file-item__summary-left">
                      <span class="recent-file-item__status"><%= item.status_label || item.status || 'File' %></span>
                      <strong class="recent-file-item__name"><%= fileNameFromPath(item.file_path) %></strong>
                      <span class="recent-file-item__meta">
                        <span class="recent-file-item__time"><%= formatDateTime(item.updated_at) %></span>
                        <span class="recent-file-item__relative"><%= formatRelativeTime(item.updated_at) %></span>
                      </span>
                    </span>
                    <span class="recent-file-item__summary-right">
                      <% if (item.change_summary) { %>
                        <span class="recent-file-item__summary"><%= item.change_summary %></span>
                      <% } %>
                      <span class="recent-file-item__chevron" aria-hidden="true">▾</span>
                    </span>
                  </button>
                  <div
                    class="recent-file-item__detail"
                    id="recent-file-detail-commit-<%= index %>"
                    data-recent-file-detail
                    aria-hidden="true"
                  >
                    <div class="recent-file-item__detail-panel">
                      <div class="recent-file-item__detail-head">
                        <code class="recent-file-item__detail-path recent-file-item__detail-path--full"><%= item.file_path %></code>
                        <a
                          class="btn recent-file-item__open-file-btn"
                          href="<%= recentFileViewerHref(item.file_path) %>"
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="Open full file"
                          title="Open full file"
                        >↗</a>
                      </div>
                      <div class="recent-file-item__detail-body recent-file-item__detail-body--diff"><%- renderDiffMarkup(item.change_detail || 'No diff available.') %></div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
            </div>
          <% } else { %>
            <div class="empty-state empty-state--compact">
              <strong>No commit yet.</strong>
              <p>Once this project has a git commit, the changed files and diff preview will show here.</p>
            </div>
          <% } %>
        </section>

        <section class="card card--usage card--usage-island" data-usage-panel data-usage-default-range="24h">
          <div class="card__header">
            <div>
              <div class="eyebrow">Usage</div>
              <h2>Project token use</h2>
            </div>
            <div class="usage-range-toggle" role="tablist" aria-label="Project usage range">
              <button type="button" class="chip" data-usage-range="24h">24h</button>
              <button type="button" class="chip" data-usage-range="7d">7d</button>
              <button type="button" class="chip" data-usage-range="30d">30d</button>
            </div>
          </div>
          <% if (projectUsageData && (projectUsageData.todayTotal || projectUsageData.weeklyTotal || projectUsageData.monthlyTotal)) { %>
            <div class="usage-summary">
              <strong><%= projectUsageData.todayTotal.toLocaleString('en-US') %> tokens today</strong>
              <span><%= projectUsageData.weeklyTotal.toLocaleString('en-US') %> tokens this week</span>
            </div>
            <div
              class="usage-chart"
              data-usage-chart
              data-usage-default-range="24h"
              data-usage-series-24h='<%- JSON.stringify(projectUsageData.series24h) %>'
              data-usage-labels-24h='<%- JSON.stringify(projectUsageData.labels24h) %>'
              data-usage-series-7d='<%- JSON.stringify(projectUsageData.series7d) %>'
              data-usage-labels-7d='<%- JSON.stringify(projectUsageData.labels7d) %>'
              data-usage-series-30d='<%- JSON.stringify(projectUsageData.series30d) %>'
              data-usage-labels-30d='<%- JSON.stringify(projectUsageData.labels30d) %>'
            ></div>
          <% } else { %>
            <div class="empty-state">
              <strong>No usage yet.</strong>
              <p>Token usage will appear here once this project starts sending messages.</p>
            </div>
          <% } %>
        </section>
      <% } else if (activeTab === 'conversations' || activeTab === 'main-agent') { %>
        <section class="chat-shell">
          <article class="card chat-panel">
            <div class="chat-panel__header">
              <div>
                <div class="eyebrow">Conversation</div>
                <h2><%= conversationAgentLabel %></h2>
              </div>
            </div>

            <div class="chat-thread">
              <% if (messages.length) { %>
                <% messages.forEach(function(message) { %>
                  <% const isOutbound = message.direction === 'outbound'; %>
                  <% const messageText = message.content || '(empty)'; %>
                  <% const truncatedMessage = truncateChatMessage(messageText); %>
                  <article class="chat-row <%= isOutbound ? 'chat-row--outbound' : 'chat-row--inbound' %>" data-message-id="<%= message.id %>">
                    <div class="chat-row__content">
                      <div class="chat-bubble">
                        <% if (truncatedMessage.truncated) { %>
                          <div class="chat-bubble__message-expander" data-message-expander data-expanded="false">
                            <pre class="chat-bubble__body chat-bubble__body--preview" data-message-preview><%= truncatedMessage.preview %></pre>
                            <pre class="chat-bubble__body chat-bubble__body--full" data-message-full hidden><%= truncatedMessage.full %></pre>
                            <button type="button" class="chat-bubble__summary" data-message-toggle aria-expanded="false">show more</button>
                          </div>
                        <% } else { %>
                          <pre class="chat-bubble__body"><%= truncatedMessage.preview %></pre>
                        <% } %>
                        <% if (message.error_text) { %>
                          <details class="chat-bubble__details chat-bubble__details--error">
                            <summary class="chat-bubble__summary">show error</summary>
                            <div class="chat-bubble__error"><%= message.error_text %></div>
                          </details>
                        <% } %>
                      </div>
                      <div class="chat-row__stamp" title="<%= formatDateTime(message.created_at) %>"><%= formatDateTime(message.created_at) %> · <%= formatRelativeTime(message.created_at) %></div>
                    </div>
                  </article>
                <% }) %>
              <% } else { %>
                <div class="empty-state">
                  <strong>No messages yet.</strong>
                  <p>Send the first prompt to OpenClaw and it will reply inline here.</p>
                </div>
              <% } %>
            </div>

            <form method="post" action="/api/project/<%= project.id %>/message" class="chat-composer" id="message_form">
              <div class="chat-composer__grid">
                <input type="hidden" id="session_id" name="session_id" value="<%= activeSession || (currentSession ? currentSession.id : '') %>" />
                <input type="hidden" id="agent_id" name="agent_id" value="<%= conversationAgentId || 'agent-openclaw-main' %>" />

                <div class="field field--full">
                  <textarea id="text" name="text" placeholder="Type your message…" rows="3"></textarea>
                </div>
              </div>

              <div class="chat-composer__actions">
                <button type="submit" class="btn btn-primary" name="message_type" value="prompt">Send</button>
              </div>
            </form>

          </article>

        </section>
      <% } else if (activeTab === 'workflows') { %>
        <section class="grid grid--two">
          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Workflow Controls</div>
                <h2>Run state and transitions</h2>
              </div>
            </div>

            <form method="post" action="/api/project/<%= project.id %>/workflows" class="stack workflow-create">
              <div class="field">
                <label for="workflow_name">New workflow</label>
                <input id="workflow_name" name="name" placeholder="Deployment task" required />
              </div>
              <div class="field">
                <label for="workflow_kind">Kind</label>
                <select id="workflow_kind" name="kind">
                  <option>planning</option>
                  <option>coding</option>
                  <option>research</option>
                  <option>debugging</option>
                  <option>deployment</option>
                  <option>review</option>
                </select>
              </div>
              <div class="actions">
                <button type="submit" class="btn btn-primary">Create workflow</button>
              </div>
            </form>

            <div class="state-chips">
              <% if (Object.keys(stats.workflowStates).length) { %>
                <% Object.entries(stats.workflowStates).forEach(function(entry) { %>
                  <span class="chip"><%= entry[0] %>: <%= entry[1] %></span>
                <% }) %>
              <% } else { %>
                <span class="chip">No workflows yet</span>
              <% } %>
            </div>
          </article>

          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Workflow List</div>
                <h2>Current workflows</h2>
              </div>
              <span class="badge badge-neutral"><%= project.workflows.length %> items</span>
            </div>

            <% if (project.workflows.length) { %>
              <div class="workflow-list">
                <% project.workflows.forEach(function(workflow) { %>
                  <div class="workflow-row">
                    <div class="workflow-row__copy">
                      <strong><%= workflow.name %></strong>
                      <span><%= workflow.kind %> | <%= workflow.state %> | <%= workflow.last_event || 'no recent event' %></span>
                    </div>
                    <form method="post" action="/api/project/<%= project.id %>/workflows/<%= workflow.id %>/state" class="workflow-row__form">
                      <select name="state">
                        <option <%= workflow.state === 'idle' ? 'selected' : '' %>>idle</option>
                        <option <%= workflow.state === 'running' ? 'selected' : '' %>>running</option>
                        <option <%= workflow.state === 'paused' ? 'selected' : '' %>>paused</option>
                        <option <%= workflow.state === 'done' ? 'selected' : '' %>>done</option>
                      </select>
                      <button type="submit" class="btn">Set</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state">
                <strong>No workflows yet.</strong>
                <p>Create one to track the next run and control state transitions from the dashboard.</p>
              </div>
            <% } %>
          </article>
        </section>
      <% } else if (activeTab === 'memory') { %>
        <section class="grid grid--two">
          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Memory</div>
                <h2>Project isolation</h2>
              </div>
            </div>
            <div class="mono-block">
              <div><span>Memory namespace</span><code><%= project.memory_namespace %></code></div>
              <div><span>Workspace</span><code><%= project.workspace_dir %></code></div>
            </div>
            <div class="bullet-stack">
              <% planning.currentState.slice(0, 4).forEach(function(item) { %>
                <div class="bullet-stack__item"><%= item %></div>
              <% }) %>
            </div>
          </article>

          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Planning</div>
                <h2>Active roadmap</h2>
              </div>
            </div>
            <div class="task-list task-list--stacked">
              <% planning.now.slice(0, 2).forEach(function(item) { %>
                <div class="task-card task-card--muted">
                  <strong><%= item.title %></strong>
                  <ul>
                    <% item.bullets.slice(0, 3).forEach(function(bullet) { %>
                      <li><%= bullet %></li>
                    <% }) %>
                  </ul>
                </div>
              <% }) %>
            </div>
            <div class="bullet-stack bullet-stack--compact">
              <% planning.health.slice(0, 4).forEach(function(item) { %>
                <div class="bullet-stack__item"><%= item %></div>
              <% }) %>
            </div>
          </article>
        </section>
      <% } else if (activeTab === 'files') { %>
        <section class="grid">
          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Files</div>
                <h2>Artifacts</h2>
              </div>
              <span class="badge badge-neutral"><%= artifacts.length %> items</span>
            </div>

            <% if (artifacts.length) { %>
              <div class="artifact-list">
                <% artifacts.forEach(function(artifact) { %>
                  <div class="artifact-item">
                    <strong><%= artifact.name %></strong>
                    <span><%= artifact.content_type %></span>
                    <code><%= artifact.file_path %></code>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state">
                <strong>No artifacts yet.</strong>
                <p>Files generated by workflows will appear here once the artifact browser is wired up.</p>
              </div>
            <% } %>
          </article>
        </section>
      <% } else if (activeTab === 'logs') { %>
        <section class="grid">
          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Logs</div>
                <h2>Recent events</h2>
              </div>
              <span class="badge badge-neutral"><%= logs.length %> entries</span>
            </div>

            <% if (logs.length) { %>
              <div class="log-list">
                <% logs.slice(0, 8).forEach(function(log) { %>
                  <div class="log-item">
                    <div class="log-item__head">
                      <strong><%= log.level %></strong>
                      <span><%= log.event_type %></span>
                      <span><%= log.created_at %></span>
                    </div>
                    <div class="log-item__body">
                      <%= log.message %>
                    </div>
                    <% if (Object.keys(log.details_json || {}).length) { %>
                      <pre><%= JSON.stringify(log.details_json, null, 2) %></pre>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty-state">
                <strong>No logs yet.</strong>
                <p>Agent routing and workflow transitions will show up here once the project starts running.</p>
              </div>
            <% } %>
          </article>
        </section>
      <% } else if (activeTab === 'settings') { %>
        <section class="grid grid--two">
          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Project Settings</div>
                <h2>Workspace configuration</h2>
              </div>
            </div>
            <form class="settings-form" method="post" action="/api/projects/<%= project.id %>/settings">
              <input type="hidden" name="return_to" value="/project/<%= project.id %>?tab=settings" />

              <div class="field">
                <label for="code_folder">Main code folder</label>
                <input id="code_folder" name="code_folder" type="text" value="<%= projectCodeFolder %>" placeholder="/home/tom/code/your-project" spellcheck="false" />
                <div class="field__hint">This is the root folder the agent uses for workspace context and file change tracking.</div>
              </div>

              <div class="field">
                <label for="backend_override">Backend override</label>
                <select id="backend_override" name="backend_override">
                  <option value="inherit" <%= (projectSettings.backend_override || projectSettings.backendOverride || 'inherit') === 'inherit' ? 'selected' : '' %>>inherit global</option>
                  <option value="openclaw-proxy" <%= (projectSettings.backend_override || projectSettings.backendOverride) === 'openclaw-proxy' ? 'selected' : '' %>>openclaw-proxy</option>
                  <option value="direct-codex" <%= (projectSettings.backend_override || projectSettings.backendOverride) === 'direct-codex' ? 'selected' : '' %>>direct-codex</option>
                  <option value="direct-opencode" <%= (projectSettings.backend_override || projectSettings.backendOverride) === 'direct-opencode' ? 'selected' : '' %>>direct-opencode</option>
                  <option value="routstr" <%= (projectSettings.backend_override || projectSettings.backendOverride) === 'routstr' ? 'selected' : '' %>>routstr</option>
                </select>
                <div class="field__hint">Projects inherit the global backend by default. Choose a backend here to override just this project.</div>
              </div>

              <div class="grid grid--two">
                <div class="field">
                  <label for="routstr_provider">Routstr provider</label>
                  <input id="routstr_provider" name="routstr_provider" type="text" value="<%= projectSettings.routstr_provider || projectSettings.routstrProvider || '' %>" placeholder="provider name" spellcheck="false" />
                </div>
                <div class="field">
                  <label for="routstr_model">Routstr model</label>
                  <input id="routstr_model" name="routstr_model" type="text" value="<%= projectSettings.routstr_model || projectSettings.routstrModel || '' %>" placeholder="model name" spellcheck="false" />
                </div>
              </div>

              <div class="field">
                <label for="getting_started">Instructions how to get going</label>
                <textarea id="getting_started" name="getting_started" rows="8" spellcheck="false" placeholder="Tell the agent how to get started..."><%= projectGettingStarted %></textarea>
                <div class="field__hint">These instructions are included in the agent prompt for this project. Folder filters are managed in Settings.</div>
              </div>

              <div class="actions">
                <button class="btn btn-primary" type="submit">Save settings</button>
              </div>
            </form>
          </article>

          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Wizard</div>
                <h2>Setup guide</h2>
              </div>
            </div>
            <div class="settings-wizard" data-settings-wizard>
              <div class="settings-wizard__step">
                <div class="settings-wizard__step-head">
                  <strong>1. Main code folder</strong>
                  <button id="wizard_use_code_folder_btn" class="btn btn-tab btn-tab--compact" type="button">Use current source</button>
                </div>
                <p>Choose the repository or workspace root the agent should treat as the main project folder. Folder filters live in Settings.</p>
              </div>

              <div class="settings-wizard__step">
                <div class="settings-wizard__step-head">
                  <strong>2. Backend override</strong>
                  <button id="wizard_fill_backend_btn" class="btn btn-tab btn-tab--compact" type="button">Use inherited backend</button>
                </div>
                <p>Keep this project on the global backend, or explicitly choose a backend just for this project.</p>
              </div>

              <div class="settings-wizard__step">
                <div class="settings-wizard__step-head">
                  <strong>3. Getting started</strong>
                  <button id="wizard_fill_instructions_btn" class="btn btn-tab btn-tab--compact" type="button">Starter instructions</button>
                </div>
                <p>Write a short prompt for how the agent should begin work in this project.</p>
              </div>

              <div class="field__hint">Use the helper buttons to prefill the form, then save the settings.</div>
            </div>
          </article>
        </section>

        <section class="grid">
          <article class="card">
            <div class="card__header">
              <div>
                <div class="eyebrow">Agents</div>
                <h2>Registry</h2>
              </div>
            </div>
            <div class="agent-grid agent-grid--compact">
              <% project.agents.forEach(function(agent) { %>
                <div class="agent-card">
                  <strong><%= agent.name %></strong>
                  <span><%= agent.role %></span>
                  <span><%= agent.kind %></span>
                </div>
              <% }) %>
            </div>
          </article>
        </section>
      <% } %>
        </div>

        <aside class="card project-rail sidebar-section sidebar-section--collapsible" data-project-rail data-sidebar-collapsible data-sidebar-default-collapsed="true" data-sidebar-section-key="workspace-changes">
          <button type="button" class="sidebar-collapse-tab project-rail__toggle" data-sidebar-collapse aria-expanded="true" aria-label="Live changes" title="Live changes">
            <span class="sidebar-collapse-tab__icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
          <div class="project-rail__resize-handle" data-project-rail-resize-handle aria-hidden="true"></div>
          <div class="project-rail__body" data-sidebar-body>
            <div class="sidebar-scroll project-rail__scroll" data-project-rail-scroll>
            <% if (activeTab === 'main-agent' && hasMainAgentInfo) { %>
              <div class="project-rail__section">
                <div class="project-rail__header">
                  <div class="project-rail__heading">
                    <h2>OpenClaw Main</h2>
                    <div class="project-rail__count">Agent details</div>
                  </div>
                </div>

                <div class="mini-list mini-list--compact">
                  <div class="mini-list__item">
                    <strong><%= mainStats.sessionCount %></strong>
                    <span>Sessions</span>
                  </div>
                  <div class="mini-list__item">
                    <strong><%= mainStats.messageCount %></strong>
                    <span>Messages</span>
                  </div>
                  <div class="mini-list__item">
                    <strong><%= mainStats.artifactCount %></strong>
                    <span>Artifacts</span>
                  </div>
                </div>

                <dl class="status-list status-list--compact">
                  <div class="status-row">
                    <dt>Agent</dt>
                    <dd><%= mainAgent.name %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Role</dt>
                    <dd><%= mainAgent.role || 'software engineer' %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Kind</dt>
                    <dd><%= mainAgent.kind || 'openclaw' %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Agent ID</dt>
                    <dd><%= mainAgent.id %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Project</dt>
                    <dd><%= hasMainProjectInfo ? mainProject.id : 'proj-openclaw-main' %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Workspace</dt>
                    <dd><%= hasMainProjectInfo ? (mainProject.workspace_dir || 'unknown') : 'unknown' %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Memory namespace</dt>
                    <dd><%= hasMainProjectInfo ? (mainProject.memory_namespace || 'unknown') : 'unknown' %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Last bootstrapped</dt>
                    <dd><%= hasMainStateInfo && mainState.openclaw_bootstrapped_at ? formatDateTime(mainState.openclaw_bootstrapped_at) : 'never' %></dd>
                  </div>
                  <div class="status-row">
                    <dt>Last seen</dt>
                    <dd><%= hasMainStateInfo && mainState.openclaw_last_seen_at ? formatDateTime(mainState.openclaw_last_seen_at) : 'never' %></dd>
                  </div>
                </dl>
              </div>
            <% } %>
            <% if (activeTab !== 'main-agent') { %>
              <div class="project-rail__section">
                <div class="project-rail__header">
                  <div class="project-rail__heading">
                    <h2>Live changes</h2>
                    <div class="project-rail__count" data-recent-files-count><%= recentFiles.length %> items</div>
                  </div>
                  <div class="project-rail__meta">
                    <div class="project-rail__sort-row">
                      <div class="project-rail__sorts" role="tablist" aria-label="Sort recent files">
                        <button
                          type="button"
                          class="btn-tab project-rail__sort-button"
                          data-recent-files-sort-option="recent"
                          data-recent-files-sort-default="desc"
                          aria-selected="<%= recentFileSortKey === 'recent' ? 'true' : 'false' %>"
                        >
                          <span class="project-rail__sort-label">Recent</span>
                          <span class="project-rail__sort-arrow" data-recent-files-sort-arrow aria-hidden="true"><%= recentFileSortKey === 'recent' ? recentFileSortArrow('recent', recentFileSortDirection) : '' %></span>
                        </button>
                        <button
                          type="button"
                          class="btn-tab project-rail__sort-button"
                          data-recent-files-sort-option="name"
                          data-recent-files-sort-default="asc"
                          aria-selected="<%= recentFileSortKey === 'name' ? 'true' : 'false' %>"
                        >
                          <span class="project-rail__sort-label">Name</span>
                          <span class="project-rail__sort-arrow" data-recent-files-sort-arrow aria-hidden="true"><%= recentFileSortKey === 'name' ? recentFileSortArrow('name', recentFileSortDirection) : '' %></span>
                        </button>
                        <button
                          type="button"
                          class="btn-tab project-rail__sort-button"
                          data-recent-files-sort-option="path"
                          data-recent-files-sort-default="asc"
                          aria-selected="<%= recentFileSortKey === 'path' ? 'true' : 'false' %>"
                        >
                          <span class="project-rail__sort-label">Relative</span>
                          <span class="project-rail__sort-arrow" data-recent-files-sort-arrow aria-hidden="true"><%= recentFileSortKey === 'path' ? recentFileSortArrow('path', recentFileSortDirection) : '' %></span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <div
                  class="recent-files-shell recent-files-shell--rail"
                  data-recent-files-root
                  data-recent-files-url="/api/project/<%= project.id %>/recent-files"
                  data-recent-files-sort="<%= recentFileSortState %>"
                  data-recent-files-tab="<%= activeTab %>"
                  data-recent-files-limit="25"
                >
                  <div class="artifact-list artifact-list--compact recent-files-list" data-recent-files-list <%= recentFiles.length ? '' : 'hidden' %>>
                  <% recentFiles.forEach(function(item, index) { %>
                      <div
                        class="recent-file-item"
                        data-recent-file-item
                        data-file-index="<%= index %>"
                        data-status-label="<%= item.status_label || item.status || 'File' %>"
                        data-file-path="<%= item.file_path %>"
                        data-file-name="<%= fileNameFromPath(item.file_path) %>"
                        data-file-updated-at="<%= item.updated_at || '' %>"
                        data-file-updated-label="<%= formatDateTime(item.updated_at) %>"
                        data-file-updated-relative="<%= formatRelativeTime(item.updated_at) %>"
                        data-file-summary="<%= item.change_summary || '' %>"
                        aria-expanded="false"
                      >
                        <button
                          type="button"
                          class="artifact-item artifact-item--button recent-file-item__trigger"
                          data-recent-file-trigger
                          aria-expanded="false"
                          aria-controls="recent-file-detail-rail-<%= index %>"
                        >
                          <span class="recent-file-item__summary-left">
                            <span class="recent-file-item__status"><%= item.status_label || item.status || 'File' %></span>
                            <strong class="recent-file-item__name"><%= fileNameFromPath(item.file_path) %></strong>
                            <span class="recent-file-item__meta">
                              <span class="recent-file-item__time"><%= formatDateTime(item.updated_at) %></span>
                              <span class="recent-file-item__relative"><%= formatRelativeTime(item.updated_at) %></span>
                            </span>
                          </span>
                          <span class="recent-file-item__summary-right">
                            <% if (item.change_summary) { %>
                              <span class="recent-file-item__summary"><%= item.change_summary %></span>
                            <% } %>
                            <span class="recent-file-item__chevron" aria-hidden="true">▾</span>
                          </span>
                        </button>
                        <div
                          class="recent-file-item__detail"
                          id="recent-file-detail-rail-<%= index %>"
                          data-recent-file-detail
                          aria-hidden="true"
                        >
                          <div class="recent-file-item__detail-panel">
                            <div class="recent-file-item__detail-head">
                              <code class="recent-file-item__detail-path recent-file-item__detail-path--full"><%= item.file_path %></code>
                              <a
                                class="btn recent-file-item__open-file-btn"
                                href="<%= recentFileViewerHref(item.file_path) %>"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Open full file"
                                title="Open full file"
                              >↗</a>
                            </div>
                            <div class="recent-file-item__detail-body recent-file-item__detail-body--diff"><%- renderDiffMarkup(item.change_detail || 'No diff available.') %></div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                  <div class="empty-state empty-state--compact" data-recent-files-empty <%= recentFiles.length ? 'hidden' : '' %>>
                    <strong>No recent files.</strong>
                    <p>Workspace changes and recent artifacts appear here.</p>
                  </div>
                </div>
              </div>
            <% } else if (!hasMainAgentInfo) { %>
              <div class="project-rail__section">
                <div class="empty-state empty-state--compact">
                  <strong>OpenClaw Main not available.</strong>
                  <p>OpenClaw Main details will appear here once the project is bootstrapped.</p>
                </div>
              </div>
            <% } %>
            </div>
          </div>
        </aside>
      </div>
    </main>
  </div>
  <script>
    window.PROJECT_SETTINGS_WIZARD = <%- JSON.stringify(typeof projectSettingsWizard !== 'undefined' ? projectSettingsWizard : {}) %>;
    window.PROJECT_CONTEXT = <%- JSON.stringify({
      projectId: project.id,
      sessionId: activeSession || (currentSession ? currentSession.id : ''),
      activeTab: activeTab,
      view: projectView,
      selection: {
        file: '',
        agent: activeTab === 'main-agent' || activeTab === 'conversations' ? conversationAgentId : '',
      },
    }) %>;
  </script>
  <script src="/public/sidebar-sections.js" defer></script>
  <script src="/public/home-usage.js" defer></script>
  <script src="/public/settings-page.js" defer></script>
  <script src="/public/project-page.js" defer></script>
  <script src="/public/pwa-register.js" defer></script>
</body>
</html>
